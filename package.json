{
  "name": "mdview-cli",
  "version": "1.0.0",
  "description": "Beautiful terminal Markdown viewer — syntax highlighting, tables, images, math, Mermaid, presentation mode & more",
  "bin": {
    "md": "./dist/index.js"
  },
  "type": "module",
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "markdown",
    "terminal",
    "cli",
    "viewer",
    "md",
    "render",
    "highlight",
    "presentation",
    "mermaid",
    "math",
    "latex"
  ],
  "author": "danwoo1234",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/danwoo1234/mdview-cli.git"
  },
  "homepage": "https://danwoo1234.github.io/mdview-cli",
  "dependencies": {
    "chalk": "^5.3.0",
    "chokidar": "^3.6.0",
    "cli-highlight": "^2.1.11",
    "marked": "^12.0.0",
    "string-width": "^7.2.0",
    "terminal-image": "^2.0.0",
    "wrap-ansi": "^9.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0"
  }
}
